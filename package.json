{
  "name": "opencode-tlc-spec-driven",
  "version": "0.1.0",
  "description": "opencode plugin centered on tlc-spec-driven: branch conventions, session renaming, and worktree automation",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skill",
    "scripts"
  ],
  "scripts": {
    "postinstall": "node scripts/install-skill.cjs",
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test",
    "format": "prettier --write src test"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.15",
    "jsonc-parser": "^3.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.11.5",
    "bun-types": "latest",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.2.4"
  }
}
